    "health.onboarding.continue": {
      "comment": "Health onboarding button: shows the system Health sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
