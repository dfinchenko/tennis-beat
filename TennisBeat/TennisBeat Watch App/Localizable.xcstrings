    "score.summary.me.choice %@ %@": {
      "comment": "VoiceOver score summary; %1$@ is the server's points, %2$@ the receiver's (server's score first, ITF GM-01)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@, I'm serving, receiver chooses the side"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@, serwuję, stronę wybiera odbierający"
